# -----------------------------------------------------------------------------
# Falsora Core API Environment Variables
# -----------------------------------------------------------------------------

# Server Configuration
PORT=4000
NODE_ENV=development

# Database (PostgreSQL / Neon)
# Replace with your actual Neon/Supabase connection string
DATABASE_URL="postgresql://user:password@hostname:5432/dbname?sslmode=require"

# JWT Secret for Auth
# Change this in production
JWT_SECRET="super-secret-key-change-in-prod"

# AI Engine Connection (Separate Python Microservice)
# Where the Core API should send frames/images for analysis
AI_ENGINE_URL="http://localhost:8000"

# Decision Engine Connection (Mehreen's stateless trust-scoring service)
DECISION_ENGINE_URL="http://localhost:8001"
