# ============================================================
# Falsora — repository ignore rules
# ============================================================
# NOTE: this file previously began with a UTF-8 BOM, which made the first
# pattern read as "\ufeff__pycache__/" and therefore never match. The BOM has
# been removed so __pycache__/ is actually ignored. Please keep this file
# saved as UTF-8 WITHOUT BOM (VS Code: bottom-right encoding selector).

# ---- Original team rules (backend) ----
__pycache__/
*.pyc
.env
venv/
.venv/
*.db
*.sqlite3

# ============================================================
# AI engine additions (Maheen — modules 6.6 / 6.7 / 6.16 / optimization)
# ------------------------------------------------------------
# CRITICAL: raw_datasets/ is ~26 GB. GitHub rejects files over 100 MB and
# warns above 50 MB. A single accidental `git add .` would break this
# repository for the whole team, so these rules must not be removed.
# ============================================================

# ---- Datasets (26 GB raw + ~4 GB derived) ----
raw_datasets/
datasets/
extracted_frames/
face_crops/
manifests/*.csv
manifests/*.parquet
# ...but the video manifest IS committed (1 MB). It is the artefact that makes
# the identity-disjoint splits reviewable in a pull request and reproducible on
# another machine. crops.csv stays ignored: it is derived, ~97k rows, and
# regenerated by `python -m falsora_ai.data extract`.
!manifests/videos.csv
*.mp4
*.avi
*.mov
*.mkv

# ---- Model weights & artefacts ----
models/
checkpoints/
outputs/
gradcam/
optimization/*.onnx
*.pt
*.pth
*.ckpt
*.onnx
*.tflite
*.engine

# ---- Python (extends the rules above) ----
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
env/
ENV/

# ---- Testing & tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- IDE ----
.idea/
.vscode/
*.swp

# ---- Secrets ----
.env.*
!.env.example
*.key
*.pem

# ---- Logs & experiment tracking ----
logs/
*.log
runs/
wandb/
mlruns/

# ---- OS ----
.DS_Store
Thumbs.db

# ---- Explicit keeps ----
!.gitkeep
!manifests/.gitkeep
